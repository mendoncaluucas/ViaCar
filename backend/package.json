  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.20.2",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "6.19.3",
    "tsx": "^4.23.13",
