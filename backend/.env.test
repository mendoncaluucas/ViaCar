# Configuração usada apenas pelos testes automatizados.
#
# Banco SEPARADO do de desenvolvimento: a suíte limpa as tabelas antes de cada
# teste, e apontar para o banco errado apagaria os dados do dia. O sufixo "_test"
# é verificado em tempo de execução por tests/setup.ts — sem ele a suíte aborta.
#
# Vai para o git de propósito: não tem segredo real aqui, e sem ele o
# `npm test` não roda num clone novo.
DATABASE_URL="postgresql://viacar:viacar@localhost:5433/viacar_test?schema=public"

PORT=3334
NODE_ENV=test

JWT_SECRET="segredo-exclusivo-da-suite-de-testes-automatizados"
JWT_EXPIRES_IN="8h"

CORS_ORIGIN="http://localhost:5173"
