# Banco de dados (bate com o docker-compose.yml)
# Porta 5433 no host para nao conflitar com outro Postgres que voce ja tenha rodando.
DATABASE_URL="postgresql://viacar:viacar@localhost:5433/viacar?schema=public"

# Servidor
PORT=3333
NODE_ENV=development

# Autenticacao
# 8h = jornada de trabalho: o funcionario loga de manha e o token cobre a carona da volta
JWT_SECRET="troque-este-valor-antes-de-qualquer-deploy"
JWT_EXPIRES_IN="8h"

# Origem liberada no CORS (porta padrao do Vite)
CORS_ORIGIN="http://localhost:5173"
